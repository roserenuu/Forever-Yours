# Jesus Forever Yours - AI Brand Agent Configuration
# Copy this to .env and fill in your values

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Discord Bot Token (optional - for Discord channel)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-server-id

# Instagram DMs (optional - for Instagram Messaging API)
# Set up at https://developers.facebook.com
INSTAGRAM_ACCESS_TOKEN=your-page-access-token
INSTAGRAM_VERIFY_TOKEN=forever-yours-verify
INSTAGRAM_WEBHOOK_PORT=8585
# Auto-register webhook URL on startup (set to your ngrok/tunnel URL, no trailing slash)
INSTAGRAM_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Gateway Configuration
GATEWAY_PORT=18789
WEBCHAT_PORT=3000

# Brand Configuration
BRAND_NAME="Jesus Forever Yours"
CREATOR_NAME="Rose Renuu"
WEBSITE_URL="https://jesusforeveryours.com"
INSTAGRAM_HANDLE="jesusforeveryours"
CREATOR_INSTAGRAM="roserenuu"
