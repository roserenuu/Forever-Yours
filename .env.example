# Jesus Forever Yours - AI Brand Agent Configuration
# Copy this to .env and fill in your values

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Discord Bot Token (optional - for Discord channel)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-server-id

# Telegram Bot Token (optional - for Telegram channel)
# 1. Open Telegram and message @BotFather
# 2. Send /newbot and follow the prompts to create your bot
# 3. Copy the token BotFather gives you and paste below
# 4. (Optional) To restrict to only you: message your bot, then visit
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and find your chat ID in the response
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_OWNER_CHAT_ID=your-chat-id

# Gateway Configuration
GATEWAY_PORT=18789
WEBCHAT_PORT=3000

# Brand Configuration
BRAND_NAME="Jesus Forever Yours"
CREATOR_NAME="Rose Renuu"
WEBSITE_URL="https://jesusforeveryours.com"
INSTAGRAM_HANDLE="jesusforeveryours"
CREATOR_INSTAGRAM="roserenuu"

# ══════════════════════════════════════════════════════════
# PLATFORM API KEYS — for /fetch to pull your analytics
# Fill in only the platforms you want to connect
# ══════════════════════════════════════════════════════════

# ── Facebook App (needed for long-lived tokens — 60 days instead of 1 hour) ──
# 1. Go to developers.facebook.com > Your App > Settings > Basic
# 2. Copy the App ID and App Secret
# 3. Run: npx ts-node src/cli/refresh-token.ts
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Instagram @roserenuu (Rose's personal creator account) ──
# 1. Go to developers.facebook.com
# 2. Create a new App (type: Business)
# 3. Add "Instagram Graph API" product
# 4. Go to Tools > Graph API Explorer
# 5. Select your app, click "Get Token" > "Get User Access Token"
# 6. Check: instagram_basic, instagram_manage_insights, pages_show_list
# 7. When prompted, select @roserenuu as the Instagram account
# 8. Click "Generate Access Token" and paste below
# 9. IMPORTANT: Exchange for a long-lived token (60 days)
INSTAGRAM_ROSERENUU_TOKEN=

# ── Instagram @jesusforeveryours (brand account — 144K) ──
# Same steps as above, but select @jesusforeveryours when generating the token
# You can use the SAME Facebook App for both accounts — just generate 2 tokens
INSTAGRAM_JFY_TOKEN=

# ── YouTube (via Google Cloud) ──
# 1. Go to console.cloud.google.com
# 2. Create a new project (or select existing)
# 3. Go to APIs & Services > Library
# 4. Search "YouTube Data API v3" and Enable it
# 5. Go to APIs & Services > Credentials > Create Credentials > API Key
# 6. Copy the API key below
# 7. For Channel ID: Go to youtube.com > Your Channel > Settings > Advanced > Channel ID
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ── TikTok ──
# NOTE: TikTok's API requires app review which can take weeks.
# For now, CSV import (/import) is much easier:
#   1. Open TikTok app > Profile > Menu > Creator tools > Analytics
#   2. Export your data
#   3. Use: /import path/to/tiktok_data.csv
#
# If you want API access:
# 1. Go to developers.tiktok.com
# 2. Create an app
# 3. Request scopes: user.info.basic, video.list
# 4. Submit for review
# 5. Once approved, generate access token
TIKTOK_ACCESS_TOKEN=

# ── OpenAI Whisper (transcribes your Instagram Reels + TikToks) ──
# This lets Navi analyze what you're SAYING in your videos — not just the metrics.
# She'll tell you which hooks, topics, and tone are performing best.
# 1. Go to platform.openai.com
# 2. Create an API key
# 3. Add billing (Whisper costs ~$0.006/minute — a 60s Reel costs less than 1 cent)
OPENAI_API_KEY=

# ── X / Twitter ──
# 1. Go to developer.x.com and sign up for a developer account
# 2. Create a Project and an App inside it
# 3. Go to your App > Keys and Tokens
# 4. Generate a Bearer Token (under "Authentication Tokens")
# 5. For User ID: Go to tweeterid.com and enter your @handle
X_BEARER_TOKEN=
X_USER_ID=
